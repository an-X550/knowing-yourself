{
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "幸福日志|开心的事情|充实的事情|待改进|感谢的人|思考.*改进|todolist",
        "hooks": [
          {
            "type": "command",
            "command": "skill log"
          }
        ]
      }
    ],
    "Stop": [
  {
    "matcher": "",
    "hooks": [
      {
        "type": "command",
        "command": "bash -c 'STATUS=$(git status --porcelain 2>/dev/null); if [ -n \"$STATUS\" ]; then echo; echo \"⚠️ 提醒：你有未提交的代码改动。输入 /提交 即可一键提交推送。\"; echo; fi'"
      }
    ]
  }
]

  },
  "journaling": {
    "journal_path": "日志/",
    "weekly_path": "日志/周志/",
    "monthly_path": "日志/月志/",
    "output_path": "复盘/",
    "context_path": "关于我/",
    "fallback_paths": {
      "journal": "06 Agenda/Journal/",
      "weekly": "06 Agenda/Weekly/",
      "monthly": "06 Agenda/Monthly/",
      "output": "07 Context/Analysis/",
      "context": "07 Context/"
    }
  },
  "permissions": {
    "allow": ["Edit", "Write", "Bash"],
    "deny": []
  }
}
